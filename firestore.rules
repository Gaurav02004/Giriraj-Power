rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller is the Admin UID or has admin claim
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'ADMIN_MASTER_UID_DEFAULT' ||
        request.auth.token.admin == true
      );
    }

    // 1. Users collection: users can read/write profile
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Products collection: public read for product catalog, authenticated/admin write for stock & seeding
    match /products/{productId} {
      allow read, write: if true;
    }

    // 3. Orders collection: read/create/update order dispatches
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. Admin Notifications:
    match /adminNotifications/{notificationId} {
      allow read, write: if true;
    }

    // 5. Default Deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
